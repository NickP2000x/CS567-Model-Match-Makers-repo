# Optional frontend configuration. Everything in VITE_* is public and ends up in the browser
# bundle: never put keys here. Copy to frontend/.env.local (ignored by Git) to use it.

# Backend origin for API mode (#39). Leave unset to use the in-memory mock.
# Development builds need the backend started with DEV_CONTROLS=true.
# VITE_API_BASE_URL=http://127.0.0.1:8000
