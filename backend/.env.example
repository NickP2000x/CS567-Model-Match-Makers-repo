# Optional backend configuration. The backend runs in mock mode without any .env file.
# To override a value, copy this file to backend/.env (ignored by Git) and edit it there.
# Never put real keys in this example, in frontend VITE_* variables, or in logs.

# "mock" (default): simulated agent replies, no model calls.
# "real": calls SMALL_MODEL / LARGE_MODEL. Startup fails if a needed key is missing.
MODEL_MODE=mock

# provider:model, provider is openai or ollama. Defaults follow the paper (Mixtral 8x7B small,
# GPT-4 Turbo large); substitutions need researcher approval.
SMALL_MODEL=
LARGE_MODEL=

# Server-only secret, needed when either model uses openai. Leave empty otherwise.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Non-secret local Ollama address (OpenAI-compatible API at /v1).
OLLAMA_BASE_URL=http://localhost:11434

# Per-call timeout and the most tool-using model calls per participant message.
MODEL_TIMEOUT_SECONDS=
AGENT_MAX_STEPS=

# SQLite file for the catalog and sessions (#33/#34). Relative paths resolve against backend/.
DATABASE_PATH=data/model-matchmakers.sqlite3

# Development-only sequence selection and reset. Keep false for participant use.
# The frontend dev server (`scripts/frontend.sh dev`) in API mode needs this set to true.
DEV_CONTROLS=false

# Comma-separated browser origins allowed to call the API (defaults: local Vite dev/preview).
CORS_ORIGINS=
